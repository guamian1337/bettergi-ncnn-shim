<Project Sdk="Microsoft.NET.Sdk">

  <!--
    原生包打包工程：把 build_shim.bat 产出的 ncnn_shim.dll 打成原生 NuGet 包。
    用法：
      1) build_shim.bat 产出 dll 到 dist/win-x64/
      2) dotnet pack pack/Guamian.BetterGI.NcnnShim.csproj -c Release -o artifacts
    dll 位于包内 runtimes/win-x64/native/（NuGet 原生包标准布局），
    消费者还原/发布时由 NuGet 标准机制复制到输出目录 runtimes/win-x64/native/。
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>Guamian.BetterGI.NcnnShim</PackageId>
    <Version>0.1.2</Version>
    <Authors>bettergi-ncnn-shim</Authors>
    <Description>BetterGI ncnn Vulkan 胶水层原生库（C ABI shim，静态链接 ncnn + glslang + SPIRV）</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoBuild>true</NoBuild>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>false</DevelopmentDependency>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\dist\win-x64\ncnn_shim.dll" Pack="true" PackagePath="runtimes/win-x64/native/" Condition="Exists('..\dist\win-x64\ncnn_shim.dll')" />
  </ItemGroup>

</Project>
